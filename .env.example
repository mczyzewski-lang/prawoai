# Skopiuj do pliku .env i uzupełnij. Plik .env nie trafia do repozytorium.
# Klucz API OpenAI – używany wyłącznie przez serwer (server/index.mjs), nigdy w przeglądarce.
OPENAI_API_KEY=
# Model do oceny umów (domyślnie gpt-5.5)
OPENAI_MODEL=gpt-5.5
# Wysiłek rozumowania dla modeli GPT-5: low | medium | high
OPENAI_REASONING_EFFORT=medium
# Port serwera API (Vite przekierowuje na niego /api)
API_PORT=8787
# Limit analiz AI na adres IP na godzinę (ochrona klucza na publicznym serwerze)
ANALYZE_LIMIT_PER_HOUR=10
